{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default",
    "opener:default",
    {
      "comment": "open_url 裸授权同为空 allow 列表全拒(插件 is_url_allowed 对空列表 any 返回 false,同 open-path 的坑);default 只覆盖 mailto/tel/http/https 四协议——聊天链接统一外开(spec §5)要放行任意协议/域名(AI 回复链接不可预知,weread:// 等自定义协议),须带通配 scope",
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "**" }]
    },
    {
      "comment": "open_path 须带 scope 条目——裸授权时插件 allow 列表为空、一切路径被 ForbiddenPath 拒绝(2026-09-23 导出后打开报障根因,同修 openInEditor)",
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-html",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-read-image",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "**" }]
    },
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:webview:allow-create-webview-window",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
