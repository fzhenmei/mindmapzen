{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "fs:default",
      "allow": [{ "path": "**" }]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-remove"
  ]
}
